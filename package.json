{
  "name": "alltrace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "start": "npm run build && npm run preview",
